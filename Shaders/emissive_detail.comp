#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_samplerless_texture_functions : enable
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : enable

#include "globals.inc"

layout (push_constant) uniform PushConsts
{
	uint num_lights;
	uint first_tile;
	uint publication_mode;
}
push_constants;

layout (constant_id = 0) const bool transient_overlay = false;
layout (constant_id = 1) const bool modulated_sources = true;
const bool indexed_sources = true;
bool cache_visibility;

#define EMISSIVE_PUBLICATION_INVALIDATE 1u
#define EMISSIVE_PUBLICATION_NO_VISIBILITY 2u

struct emissive_light_t
{
	vec3  origin;
	float radius;
	vec3  color;
	float intensity;
};

layout (set = 0, binding = 0, rgba16f) uniform writeonly image2D output_image;
layout (set = 0, binding = 1) uniform utexture2D surface_indices;
layout (std430, set = 0, binding = 2) readonly restrict buffer surfaces_buffer
{
	surface_t surfaces[];
};
layout (std430, set = 0, binding = 3) readonly restrict buffer world_verts_buffer
{
	world_vert_t world_verts[];
};
layout (std430, set = 0, binding = 4) readonly restrict buffer surface_submodels_buffer
{
	uint surface_submodels[];
};
layout (std430, set = 0, binding = 5) readonly restrict buffer emissive_lights_buffer
{
	emissive_light_t emissive_lights[];
};
struct emissive_tile_t
{
	uint first_source;
	uint num_sources;
	uint packed_tile;
};

layout (std430, set = 0, binding = 6) readonly restrict buffer emissive_tiles_buffer
{
	emissive_tile_t emissive_tiles[];
};
layout (std430, set = 0, binding = 7) readonly restrict buffer emissive_source_indices_buffer
{
	uint emissive_source_indices[];
};
layout (set = 0, binding = 8) uniform texture2D cacheable_image;
layout (std430, set = 0, binding = 9) readonly restrict buffer emissive_modulations_buffer
{
	float emissive_modulations[];
};
layout (std430, set = 0, binding = 10) restrict buffer emissive_visibility_buffer
{
	uint emissive_visibility[];
};
layout (set = 1, binding = 0) uniform accelerationStructureEXT tlas;

bool EmissiveIsOccluded (const vec3 world_pos, const vec3 normal, const vec3 light_origin)
{
	const vec3 ray_origin = world_pos + normal * 0.25f;
	const vec3 ray_vector = light_origin - ray_origin;
	const float ray_distance = length (ray_vector);
	if (ray_distance <= 0.5f)
		return false;

	rayQueryEXT ray_query;
	rayQueryInitializeEXT (
		ray_query, tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT | gl_RayFlagsSkipClosestHitShaderEXT, 0xFF, ray_origin, 0.0f,
		ray_vector / ray_distance, ray_distance - 0.5f);
	rayQueryProceedEXT (ray_query);
	return rayQueryGetIntersectionTypeEXT (ray_query, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
}

#include "lightmap_coords.inc"
#define EMISSIVE_DETAIL_VISIBILITY
#define EMISSIVE_SOURCE_INDICES
#include "emissive_lighting.inc"

layout (local_size_x = 8, local_size_y = 8) in;
void main ()
{
	cache_visibility = !transient_overlay && push_constants.publication_mode != EMISSIVE_PUBLICATION_NO_VISIBILITY;
	const emissive_tile_t tile = emissive_tiles[push_constants.first_tile + gl_WorkGroupID.z];
	const ivec2 tile_coords = ivec2 ((tile.packed_tile >> 16) & 0xFFu, tile.packed_tile >> 24);
	const ivec2 coords = tile_coords * 16 + ivec2 (gl_GlobalInvocationID.xy);
	if (any (greaterThanEqual (coords, imageSize (output_image))))
		return;
	if (transient_overlay && push_constants.publication_mode == EMISSIVE_PUBLICATION_INVALIDATE)
	{
		imageStore (output_image, coords, vec4 (0.0f));
		return;
	}

	vec3		 contribution = vec3 (0.0f);
	float		 validity = 0.0f;
	const ivec2 coarse_coords = coords / 2;
	const uint surface_index = texelFetch (surface_indices, coarse_coords, 0).x;
	if (surface_index != 0xFFFFFFFFu && (surface_index & 0x80000000u) == 0u && surface_submodels[surface_index] == 0u)
	{
		const surface_t surf = surfaces[surface_index];
		// Detail coordinates include the raster texel-center offset; remove it exactly once after scaling.
		const float		s = (float (coords.x) + 0.5f) * 0.5f - float (surf.packed_light_st & 0xFFFFu) - 0.5f;
		const float		t = (float (coords.y) + 0.5f) * 0.5f - float (surf.packed_light_st >> 16) - 0.5f;
		vec3			tangent;
		vec3			bitangent;
		const vec3		world_pos = CalculateWorldPos (surf, s, t, tangent, bitangent);
		vec3			normal = vec3 (surf.normal_x, surf.normal_y, surf.normal_z);
		if (((surf.packed_tex_edgecount >> 15) & 1u) != 0u)
			normal = -normal;

		const uint visibility_texel = gl_GlobalInvocationID.y * 16u + gl_GlobalInvocationID.x;
		contribution = CalculateEmissiveContribution (world_pos, normal, tile.first_source, tile.num_sources, visibility_texel);
		validity = 1.0f;
	}
	if (transient_overlay)
	{
		const vec4 cacheable = texelFetch (cacheable_image, coords, 0);
		contribution += cacheable.rgb;
	}

	imageStore (output_image, coords, vec4 (contribution, validity));
}
