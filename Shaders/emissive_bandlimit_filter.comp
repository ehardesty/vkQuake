#version 460
#extension GL_EXT_samplerless_texture_functions : enable

layout (push_constant) uniform PushConsts
{
	uint horizontal;
	uint add_existing;
	uint first_tile;
}
push_constants;

layout (set = 0, binding = 0, rgba16f) uniform image2D output_image;
layout (set = 0, binding = 1) uniform utexture2D surface_indices;
layout (set = 0, binding = 8) uniform texture2D input_image;
struct emissive_tile_t
{
	uint first_source;
	uint num_sources;
	uint packed_tile;
};
layout (std430, set = 0, binding = 6) readonly restrict buffer emissive_tiles_buffer
{
	emissive_tile_t emissive_tiles[];
};

const float weights[5] = float[5] (1.0f, 4.0f, 6.0f, 4.0f, 1.0f);

layout (local_size_x = 8, local_size_y = 8) in;
void main ()
{
	const emissive_tile_t tile = emissive_tiles[push_constants.first_tile + gl_WorkGroupID.z];
	const ivec2 tile_coords = ivec2 ((tile.packed_tile >> 16) & 0xFFu, tile.packed_tile >> 24) * 16;
	const ivec2 coords = tile_coords + ivec2 (gl_GlobalInvocationID.xy);
	if (any (greaterThanEqual (coords, imageSize (output_image))))
		return;
	const ivec2 coarse_coords = coords / 2;
	const uint surface = texelFetch (surface_indices, coarse_coords, 0).x;
	if (surface == 0xFFFFFFFFu || (surface & 0x80000000u) != 0u)
	{
		if (push_constants.add_existing == 0u)
			imageStore (output_image, coords, vec4 (0.0f));
		return;
	}

	vec3 sum = vec3 (0.0f);
	float weight_sum = 0.0f;
	for (int offset = -2; offset <= 2; ++offset)
	{
		const ivec2 sample_coords = coords + (push_constants.horizontal != 0u ? ivec2 (offset, 0) : ivec2 (0, offset));
		if (any (lessThan (sample_coords, ivec2 (0))) || any (greaterThanEqual (sample_coords, textureSize (input_image, 0))))
			continue;
		if (texelFetch (surface_indices, sample_coords / 2, 0).x != surface)
			continue;
		const vec4 sample_value = texelFetch (input_image, sample_coords, 0);
		if (sample_value.a <= 0.0f)
			continue;
		const float weight = weights[offset + 2];
		sum += weight * sample_value.rgb;
		weight_sum += weight;
	}
	vec3 result = weight_sum > 0.0f ? sum / weight_sum : vec3 (0.0f);
	float validity = weight_sum > 0.0f ? 1.0f : 0.0f;
	if (push_constants.add_existing != 0u)
	{
		const vec4 existing = imageLoad (output_image, coords);
		result += existing.rgb;
		validity = max (validity, existing.a);
	}
	imageStore (output_image, coords, vec4 (result, validity));
}
